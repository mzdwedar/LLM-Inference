# Template. Copy to .env and fill in real values:  cp .env.example .env
#
# Load into a shell before running the runbook commands:
#     set -a; source .env; set +a
# Python scripts pick these up automatically via python-dotenv.
#
# Hugging Face access token (model downloads, gated Llama repos)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NGC / NIM API key (TensorRT-LLM container + model profile probing)
NGC_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vast.ai GPU instance - changes every time you rent a new box
VAST_HOST=203.0.113.10
VAST_PORT=12345
VAST_USER=root
VAST_SSH_KEY=./vastssh_key
